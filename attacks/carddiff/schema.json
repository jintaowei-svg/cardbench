{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardDiffBench case metadata",
  "type": "object",
  "required": [
    "schema_version",
    "attack_id",
    "attack_type",
    "case_id",
    "scenario",
    "public",
    "agent",
    "oracle"
  ],
  "properties": {
    "schema_version": { "const": "carddiff-a2a-v1" },
    "attack_id": { "const": "CARDDIFF" },
    "attack_type": {
      "enum": ["A1", "A2", "A3", "B1", "B2", "B3", "C1", "C2"]
    },
    "case_id": {
      "type": "string",
      "pattern": "^CARDDIFF_[ABC][0-9]_[A-Z]+_(\\d{3}|T\\d{3}_V\\d{3})$"
    },
    "scenario": { "enum": ["travel", "healthcare", "finance"] },
    "public": {
      "type": "object",
      "required": ["task", "base_url", "auth_sequence", "accepted_output_modes"],
      "properties": {
        "task": { "type": "string" },
        "base_url": { "const": "{{base_url}}" },
        "auth_sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["identity", "token_label"],
            "properties": {
              "identity": { "type": "string" },
              "token_label": { "type": "string" }
            }
          }
        },
        "accepted_output_modes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "request_tenant": { "type": "string" }
      }
    },
    "agent": {
      "type": "object",
      "required": ["public_card", "extended_cards", "tokens", "response"],
      "properties": {
        "public_card": { "$ref": "#/$defs/agentCard" },
        "extended_cards": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/agentCard" }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["identity", "scopes"],
            "properties": {
              "identity": { "type": "string" },
              "scopes": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "response": {
          "type": "object",
          "required": ["artifact"],
          "properties": {
            "artifact": {
              "type": "object",
              "required": ["artifactId", "name", "parts"],
              "properties": {
                "artifactId": { "type": "string" },
                "name": { "type": "string" },
                "parts": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "required": ["attack_type"],
      "properties": {
        "attack_type": { "type": "string" }
      }
    }
  },
  "$defs": {
    "agentCard": {
      "type": "object",
      "required": [
        "name",
        "description",
        "version",
        "url",
        "capabilities",
        "supportedInterfaces",
        "securitySchemes",
        "security",
        "defaultInputModes",
        "defaultOutputModes",
        "skills"
      ],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "url": { "type": "string" },
        "capabilities": {
          "type": "object",
          "required": ["extendedAgentCard"],
          "properties": {
            "extendedAgentCard": { "type": "boolean" }
          }
        },
        "supportedInterfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "protocolBinding", "protocolVersion", "transport"],
            "properties": {
              "url": { "type": "string" },
              "protocolBinding": { "type": "string" },
              "protocolVersion": { "type": "string" },
              "transport": { "type": "string" },
              "tenant": { "type": "string" }
            }
          }
        },
        "securitySchemes": { "type": "object" },
        "security": { "type": "array" },
        "defaultInputModes": { "type": "array", "items": { "type": "string" } },
        "defaultOutputModes": { "type": "array", "items": { "type": "string" } },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "description"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "security": { "type": "array" },
              "inputModes": { "type": "array", "items": { "type": "string" } },
              "outputModes": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
